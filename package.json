{
  "name": "mazebench-voxel-tests",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build:physics": "sh scripts/build-physics.sh",
    "test:physics": "sh scripts/test-physics.sh",
    "benchmark:physics": "sh scripts/benchmark-physics.sh",
    "benchmark:search": "sh scripts/benchmark-search.sh",
    "benchmark:search:wasm": "npm run build:physics && node engine/benchmarks/wasm_search_benchmark.mjs",
    "benchmark:evolution": "node apps/web/benchmarks/evolution_generation_benchmark.mjs",
    "migrate:project-data": "node scripts/migrate-project-data.mjs",
    "migrate:tag-groups": "node scripts/migrate-tag-groups.mjs",
    "predev": "npm run build:physics",
    "dev": "cd apps/web && WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "prebuild": "npm run build:physics",
    "build": "cd apps/web && WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "cd apps/web && WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run test:physics && npm run build && node --test apps/web/tests/*.test.mjs engine/tests/*.test.mjs",
    "lint": "cd apps/web && eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "cd apps/web && drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "@ziglang/cli": "^0.0.14",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
